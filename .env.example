# Muestra detalles de los errores internos en las respuestas (NO usar en producción)
APP_DEBUG=false
 
# Prefijo de URL bajo el que se sirve la API (ej: http://localhost/api/users -> /api)
BASE_PATH=/api
 
# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=api
DB_USER=usuario
DB_PASS=password
 
# Origen permitido para CORS. Déjalo vacío para desactivar CORS, o usa "*" / "https://mi-frontend.com"
CORS_ORIGIN=
 

